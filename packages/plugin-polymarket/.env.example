# ===========================================
# Zeracle - Polymarket Trading Agent
# Environment Configuration
# ===========================================

# === LLM Provider ===
# At least one LLM provider is required
ANTHROPIC_API_KEY=your_anthropic_api_key
# OPENAI_API_KEY=your_openai_api_key

# === Polymarket Trading ===
# Ethereum private key for signing trades (required for trading)
# Without this key, the agent runs in read-only mode
POLYMARKET_PRIVATE_KEY=your_wallet_private_key

# Risk Management (all in USD)
POLYMARKET_MAX_POSITION_SIZE=50        # Max size per position
POLYMARKET_MAX_PORTFOLIO_RISK=200      # Total portfolio exposure limit
POLYMARKET_MAX_DAILY_LOSS=50           # Daily loss limit (stops trading if exceeded)
POLYMARKET_STOP_LOSS_PERCENT=20        # Automatic stop-loss percentage
POLYMARKET_TAKE_PROFIT_PERCENT=50      # Automatic take-profit percentage

# Autonomous Trading Settings
POLYMARKET_AUTO_TRADE=true             # Enable autonomous trading (true/false)
POLYMARKET_ANALYSIS_INTERVAL=300000    # Market analysis interval in ms (default: 5 min)
POLYMARKET_MIN_CONFIDENCE=75           # Minimum confidence % for auto trades (0-100)

# === Twitter Integration ===
# Required for posting trade notifications and market updates
# Get credentials at https://developer.twitter.com
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET_KEY=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret

# === Data Sources ===

# CryptoPanic - Crypto news aggregation
# Get free key at https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=your_cryptopanic_key

# CoinGecko - Cryptocurrency prices and data
# Free tier: https://www.coingecko.com/en/api
# Pro tier: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=your_coingecko_key

# DeFiLlama - DeFi protocol TVL data
# Free, no key required for basic endpoints
# DEFILLAMA_API_KEY=optional

# SportMonks - Sports data and odds
# Get key at https://www.sportmonks.com/
SPORTMONKS_API_KEY=your_sportmonks_key

# === Optional Configuration ===

# Logging level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Database (defaults to PGLite local database)
# POSTGRES_URL=postgresql://user:pass@host:5432/dbname

# === Scheduled Posts Configuration ===
# Posts are scheduled automatically:
# - Market updates: Every 2 hours (8 AM - 10 PM ET)
# - Daily briefing: 9 AM ET on weekdays
# - Weekly summary: Friday 6 PM ET

# ===========================================
# NOTES:
# - All Polymarket settings are in USD
# - Twitter credentials use OAuth 1.0a (User Context)
# - CoinGecko Pro keys start with 'CG-'
# - Data source keys are optional but enhance analysis
# ===========================================
