# ===========================================
# Polymarket Trading Agent Configuration
# ===========================================

# === LLM Provider (Anthropic Claude) ===
ANTHROPIC_API_KEY=your_anthropic_api_key

# === Polymarket Trading ===
POLYMARKET_PRIVATE_KEY=your_wallet_private_key

# Risk Management
POLYMARKET_MAX_POSITION_SIZE=50
POLYMARKET_MAX_PORTFOLIO_RISK=200
POLYMARKET_MAX_DAILY_LOSS=50
POLYMARKET_STOP_LOSS_PERCENT=20
POLYMARKET_TAKE_PROFIT_PERCENT=50

# Autonomous Trading
POLYMARKET_AUTO_TRADE=true
POLYMARKET_ANALYSIS_INTERVAL=300000
POLYMARKET_MIN_CONFIDENCE=75

# === Twitter Integration ===
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET_KEY=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret
